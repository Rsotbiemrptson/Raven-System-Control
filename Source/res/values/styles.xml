<resources>
 <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">#15A5FC</item>
  <item name="android:colorBackground">#131519</item><item name="android:windowBackground">#131519</item>
  <item name="android:textColorPrimary">#F1F2F6</item><item name="android:textColorSecondary">#A9B0BC</item>
  <item name="android:colorControlNormal">#A9B0BC</item><item name="android:alertDialogTheme">@style/ControlDialog</item>
  <item name="android:popupMenuStyle">@style/ControlPopup</item>
  <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#131519</item>
  <item name="android:navigationBarColor">#131519</item><item name="android:windowLightNavigationBar">false</item>
  <item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="ControlDialog" parent="android:style/Theme.Material.Dialog.Alert">
  <item name="android:colorAccent">#15A5FC</item><item name="android:colorBackground">#272B32</item>
  <item name="android:windowBackground">@drawable/dialog_surface</item><item name="android:textColorPrimary">#F1F2F6</item>
  <item name="android:textColorSecondary">#A9B0BC</item><item name="android:colorControlNormal">#A9B0BC</item>
  <item name="android:windowMinWidthMajor">55%</item><item name="android:windowMinWidthMinor">90%</item>
 </style>
 <style name="ControlPopup" parent="android:style/Widget.Material.PopupMenu">
  <item name="android:popupBackground">@drawable/dialog_surface</item>
 </style>
</resources>
